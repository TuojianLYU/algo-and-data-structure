CompileFlags:
    Add:
        - -IC:/msys64/mingw64/include
        - -IC:/msys64/mingw64/include/c++/13.2.0
        - -IC:/msys64/mingw64/include/c++/13.2.0/x86_64-w64-mingw32
        - -IC:/msys64/mingw64/lib/gcc/x86_64-w64-mingw32/13.2.0/include
        - -target
        - x86_64-w64-mingw32
        - -std=c++20
    Remove:
        - -W*
Diagnostics:
    ClangTidy:
        Add:
            - readability-*
            - performance-*
            - modernize-*
        Remove:
            - modernize-use-trailing-return-type
Index:
    Background: Build
Completion:
    AllScopes: true
InlayHints:
    Enabled: true
    ParameterNames: true
    TypeHints: true



